{
  "manifest_version": 3,
  "name": "YouTube Seek Edit",
  "version": "1.1.1",
  "description": "Set custom seek times for YouTube's arrow and J/L keyboard shortcuts.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "icons": { "64": "icon.svg" },
  "action": { "default_popup": "options.html", "default_title": "YouTube Seek Edit", "default_icon": "icon.svg" },
  "options_ui": { "page": "options.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-seek-edit@LouisKMills",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
